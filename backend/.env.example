# Server
CORS_ORIGINS=http://localhost:5173

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
MAX_TOKENS=1024
TEMPERATURE=0.7

# Website proxy (iframe)
PROXY_TARGET_BASE=https://www.teg.ie
PROXY_ALLOWED_HOSTS=www.teg.ie,teg.ie

# Website crawler
CRAWL_BASE_URL=https://www.teg.ie
CRAWL_OUTPUT_PATH=data/crawled_content.json
CRAWL_CONCURRENCY=25

# Hybrid chunking (recursive + semantic)
CHUNK_OUTPUT_PATH=data/chunks.json
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CHUNK_MIN_SIZE=80
CHUNK_MAX_SIZE=1200
CHUNK_SEMANTIC_SIMILARITY_THRESHOLD=0.75
CHUNK_EMBEDDING_MODEL=text-embedding-3-small
CHUNK_EMBEDDING_BATCH_SIZE=64
CHUNK_ENABLE_SEMANTIC=true
