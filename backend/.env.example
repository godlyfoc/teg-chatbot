# OpenAI
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini
MAX_TOKENS=1024
TEMPERATURE=0.7

# Reranking (Cohere) — set your key in .env only, not here
COHERE_API_KEY=your-cohere-key
COHERE_RERANK_MODEL=rerank-multilingual-v3.0
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_RERANK_TOP_K=5
RETRIEVAL_MIN_RERANK_SCORE=0.15
VALIDATION_MAX_RETRIES=2
RAG_TEMPERATURE=0.3
RAG_LOG_ENABLED=true
RAG_LOG_PATH=data/rag_requests.jsonl
# Get an API key from https://smith.langchain.com/settings
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your-key
LANGSMITH_PROJECT=teg-chatbot
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Qdrant (optional — local path or remote URL)
# QDRANT_PATH=data/qdrant
# QDRANT_URL=http://localhost:6333
